/ {
	hid_dev_0: hid_dev_0 {
		compatible = "zephyr,hid-device";
		label = "HID0";
		/* "mouse" makes the device advertise the HID boot interface
		 * (bInterfaceSubClass=1, bInterfaceProtocol=2), so the host may
		 * switch it to Boot Protocol via SET_PROTOCOL (e.g. BIOS/UEFI).
		 */
		protocol-code = "mouse";
		in-polling-period-us = <1000>;
		in-report-size = <64>;
	};
};

/* The board layout has no slot-0/slot-1 partitions, so the two DFU slots are
 * carved out of the free space that app-image otherwise claims. The 828K
 * between 0x2d000 and 0xfc000 (where storage starts) is split into 316K for
 * the application plus two 256K slots. Both offsets are 4K aligned, matching
 * the flash erase-block size.
 */
&app_partition {
	reg = <0x2d000 DT_SIZE_K(316)>;
};

&flash {
	partitions {
		dfu_slot_a: partition@7c000 {
			label = "dfu-slot-a";
			reg = <0x7c000 DT_SIZE_K(256)>;
		};

		dfu_slot_b: partition@bc000 {
			label = "dfu-slot-b";
			reg = <0xbc000 DT_SIZE_K(256)>;
		};
	};
};
