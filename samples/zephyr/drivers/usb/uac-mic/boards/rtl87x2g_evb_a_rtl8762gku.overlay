#include <zephyr/dt-bindings/usb/audio.h>

zephyr_udc0: &udc {
	status = "okay";
};

/ {
	aliases {
		test-i2s = &i2s0;
		test-codec = &codec;
	};

	/*
	 * UAC2 microphone topology (capture, device -> host):
	 *
	 *   clock -> in_clock
	 *   Microphone Input Terminal (mic_input) -> USB Streaming Output
	 *   Terminal (in_terminal) -> AudioStreaming IN endpoint (as_in)
	 *
	 * 48 kHz / 16-bit / 2 channels, front-left + front-right.
	 */
	uac2_mic: usb_audio2 {
		compatible = "zephyr,uac2";
		full-speed;
		high-speed;
		audio-function = <AUDIO_FUNCTION_MICROPHONE>;

		uac_aclk: aclk {
			compatible = "zephyr,uac2-clock-source";
			clock-type = "internal-fixed";
			frequency-control = "read-only";
			sampling-frequencies = <48000>;
		};

		mic_input: input_terminal {
			compatible = "zephyr,uac2-input-terminal";
			clock-source = <&uac_aclk>;
			terminal-type = <INPUT_TERMINAL_MICROPHONE>;
			front-left;
			front-right;
		};

		in_terminal: output_terminal {
			compatible = "zephyr,uac2-output-terminal";
			data-source = <&mic_input>;
			clock-source = <&uac_aclk>;
			terminal-type = <USB_TERMINAL_STREAMING>;
		};

		as_in: audio_streaming {
			compatible = "zephyr,uac2-audio-streaming";
			linked-terminal = <&in_terminal>;
			subslot-size = <2>;
			bit-resolution = <16>;
			/* 1000 us = bInterval 4: one 48-sample packet per poll,
			 * ~1000 sends/s. Larger/fewer transfers keep the single
			 * core from starving the I2S reader (250 us needs ~4000
			 * sends/s and empties the ring -> silence).
			 */
			polling-period-us = <1000>;
		};
	};
};

/* i2s codec rx */
&i2s0 {
	dmas = <&dma0 0 41 0x26a1>, <&dma0 1 42 0x648a>;
	dma-names = "tx", "rx";
	pinctrl-0 = <&i2s0_default>;
	pinctrl-names = "default";

	status = "okay";
	codec: codec@0 {
		compatible = "realtek,bee-codec";
		reg = <0>;
		channel-sequence = "l_r";
		mic-bias = "1_8";
		mic-bst-gain = "30dB";
		mic-bst-mode = "differential";
		mic-type = "amic";
		dmic-data-latch = "rising_latch";
		ad-gain = <0x2f>;
		boost-gain = "0dB";
		pinctrl-0 = <&codec_default>;
		pinctrl-names = "default";
		status = "okay";
	};
};

&dma0 {
    status = "okay";
};

&pinctrl {
	i2s0_default: i2s0_default {
		group1 {
			psels = <BEE_PSEL(BCLK_SPORT0, P4_0)>,
				<BEE_PSEL(LRC_RX_SPORT0, P4_1)>, /* i2s_codec_rx waveform */
				<BEE_PSEL(LRC_SPORT0, P4_2)>, /* i2s_tx/i2s_codec_tx waveform */
				<BEE_PSEL(SDI_CODEC_SLAVE, P4_3)>, /* i2s_codec_rx/tx waveform */
				<BEE_PSEL(SDO_CODEC_SLAVE, P4_4)>, /* i2s_codec_rx/tx waveform */
				<BEE_PSEL(ADCDAT_SPORT0, P4_5)>, /* i2s_tx waveform */
				<BEE_PSEL(DACDAT_SPORT0, P4_6)>; /* i2s_tx waveform */
			output-enable;
			output-low;
			bias-disable;
		};
	};

	codec_default: codec_default {
		group1 {
			psels = <BEE_PSEL(PWR_OFF, P2_6)>, /* amic */
				<BEE_PSEL(PWR_OFF, P2_7)>, /* amic */
				<BEE_PSEL(PDM_CLK, P2_4)>, /* i2s_codec_tx waveform */
				<BEE_PSEL(PDM_DATA, P2_5)>; /* i2s_codec_tx waveform */
			/* <BEE_PSEL(DMIC1_CLK, P3_2)>, /* dmic */
			/* <BEE_PSEL(DMIC1_DAT, P3_3)>; /* dmic */
			output-disable;
			bias-disable;
		};
	};
};
